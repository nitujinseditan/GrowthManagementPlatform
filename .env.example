# 数据库
DATABASE_URL=file:./data/growth-second-brain.db

# NextAuth
AUTH_SECRET=your-auth-secret-here

# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-api-key

# 应用地址
NEXT_PUBLIC_APP_URL=http://localhost:3722

# Gmail SMTP 邮件配置（邮箱验证）
# 需要 Gmail 开启两步验证并生成应用专用密码，见下方说明
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-16-chars
EMAIL_FROM=your-email@gmail.com

# ============================================
# Gmail 应用专用密码生成步骤
# ============================================
# 1. 打开 https://myaccount.google.com/security
# 2. 确保已开启"两步验证"（2-Step Verification）
# 3. 搜索"应用专用密码"（App Passwords）或直接访问
#    https://myaccount.google.com/apppasswords
# 4. 选择"Mail"作为应用类型，"Other"作为设备（填入你的应用名）
# 5. 点击"生成"，复制 16 位应用专用密码
# 6. 将密码填入 EMAIL_PASS（不含空格）
# ============================================
# 开发提示：如果 EMAIL_PASS 留空，验证链接将打印在
# 服务器控制台而非真实发送邮件，方便本地调试。
# ============================================
